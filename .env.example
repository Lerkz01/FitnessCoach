# ====================================================================
#  Cloud-Zugang
#
#  Diese Datei nach `.env` kopieren und die beiden Werte einsetzen. Ohne sie
#  läuft die App im rein lokalen Betrieb — dann ist der Fortschritt bei
#  Geräteverlust weg, und die App sagt das auch deutlich.
#
#  Beide Werte findest du im Supabase-Projekt unter
#  Settings → API → Project URL bzw. Project API keys → anon public.
#
#  WICHTIG: Hier gehört ausschließlich der `anon`-Schlüssel hinein. Er ist
#  öffentlich vorgesehen; was ein Konto sehen darf, entscheidet die Datenbank
#  über Row Level Security. Der `service_role`-Schlüssel umgeht RLS und darf
#  NIE in die App oder ins Repository.
# ====================================================================

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-schluessel
